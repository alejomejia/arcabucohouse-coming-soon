				</svg>
			</div>
			<div class="words">
				<h2>High-end interiorism <span class="inline-block">made by Colombian artisans</span></h2>
				<p class="word-highlight">Arriving on 2026</p>
			</div>
		</div>
	</main>
</Layout>

<style>
	#root {
		position: relative;
		width: 100%;
		height: 100vh;
		color: var(--color-white);
		background-color: var(--color-black);
		overflow: hidden;
	}

	#mask {
		position: absolute;
		z-index: 1;
		width: 100%;
		height: 100%;
		color: var(--color-black);
		background: var(--color-white);
		clip-path: polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%);
	}

	#keywords {
		font-size: 1.5rem;
		
		.keywords-line {
			text-wrap: nowrap;

			span {
				display: inline-block;
				will-change: transform;
			}

			&:nth-child(even) span {
				animation: moveR 60s ease-in-out;
			}

			&:nth-child(odd) span {
				animation: moveL 60s ease-in-out;
			}
		}
	}

	#images {
		position: fixed;
		z-index: 2;
		inset: 0;
		pointer-events: none;

		@media(max-width: 768px) {
			transform: scale(0.9);
		}

		.image-wrapper {
			position: absolute;
			left: 50%;
			top: 50%;
			width: 100%;
			height: 100%;
			max-width: 48rem;
			transform: translate(-50%, -50%);
			clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
			will-change: clip-path;
		}

		.image {
			position: absolute;
			top: 50%;
			transform: translateY(-50%);
			aspect-ratio: 3/2;
			clip-path: polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%);
			will-change: clip-path;
			overflow: hidden;

			img {
				position: relative;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transform: scale(1.5);
				will-change: transform;
			}
		}

		.image-split {
			display: none;
			position: absolute;
			top: 50%;
			left: 50%;
			width: 100%;
			height: 100%;
			max-width: 48rem;
			transform: translate(-50%, -50%);
			aspect-ratio: 3/2;

			.image-split-item {
				position: absolute;
				top: 50%;
				width: 100%;
				transform: translateY(-50%);
				aspect-ratio: 3/2;
			}

			.image-split-item.left {
				clip-path: polygon(0% 0%, 50% 0%, 50% 100%, 0% 100%);
			}

			.image-split-item.right {
				clip-path: polygon(50% 0%, 100% 0%, 100% 100%, 50% 100%);
			}

			img {
				position: absolute;
				width: 100%;
			}
		}
	}

	#content {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4rem;

		.tag {
			width: 100%;
			max-width: 12.5rem;
			opacity: 0;
			overflow: visible;
			
			svg {
				overflow: visible;
			}
				
			#circle {
				transform-origin: center;
				will-change: rotate;
				animation: rotate 60s ease;
			}
		}

		.logo {
			width: 100%;
			max-width: 50rem;

			@media (max-width: 768px) {
				max-width: 24rem;
			}

			path {
				opacity: 0;
			}
		}

		.words {
			text-align: center;
			opacity: 0;
			
			h2 {
				max-width: 24.375rem;
				font-size: 1.25rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 0.05rem;
				margin-bottom: 1rem;
			}

			p {
				color: var(--color-gray);
				text-transform: uppercase;
				font-size: 1.25rem;
				font-weight: 500;
				letter-spacing: 0.05rem;
				margin-bottom: 1rem;
			}

		}
	}

	@keyframes moveR {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@keyframes moveL {
		from {
			transform: translateX(-10%);
		}
		to {
			transform: translateX(0%);
		}
	}

	@keyframes rotate {
		from {
			rotate: 0deg;
		}

		to {
			rotate: 360deg;
		}
	}
</style>

<script>
	import { gsap } from 'gsap'
	import { SplitText } from 'gsap/SplitText'
	import { CustomEase } from 'gsap/CustomEase'

	const config = {
		KEYWORDS_GROUP_COUNT: 3,
		KEYWORDS_LINE_COUNT: 20,
	}

	document.addEventListener("DOMContentLoaded", () => {
		gsap.registerPlugin(SplitText, CustomEase)
		CustomEase.create('hop', '0.9, 0, 0.1, 1')

		// Select elements
		const root = document.querySelector("#root") as HTMLElement
		const mask = document.querySelector("#mask") as HTMLElement
		const keywords = document.querySelector("#keywords") as HTMLElement
		const imageWrapper = document.querySelector("#images .image-wrapper") as HTMLElement
		const images = gsap.utils.toArray<HTMLElement[]>("#images .image-wrapper .image")
		const imgs = gsap.utils.toArray<HTMLElement[]>("#images .image img")
		const imageSplit = document.querySelector("#images .image-split") as HTMLElement
		const imageSplitLeft = document.querySelector("#images .image-split-item.left") as HTMLElement
		const imageSplitRight = document.querySelector("#images .image-split-item.right") as HTMLElement
		const tag = document.querySelector("#content .tag") as HTMLElement
		const logoPaths = gsap.utils.toArray<SVGPathElement>("#content .logo path")
		const wordsWrapper = document.querySelector("#content .words") as HTMLElement

		// Early return if essential elements are missing
		if (
			!root || 
			!mask || 
			!keywords || 
			!imageWrapper || 
			!imageSplit || 
			!imageSplitLeft || 
			!imageSplitRight ||
			!tag ||
			logoPaths.length === 0 ||
			!wordsWrapper
		) return

		// Initialize clip-path states using gsap.set()
		gsap.set(images, {
			clipPath: "polygon(0% 100%, 100% 100%, 100% 100%, 0% 100%)"
		})

		gsap.set(imgs, {
			scale: 1.5
		})

		// Clone keywords
		function cloneKeywords() {
			const group = document.querySelector(".keywords-group") as HTMLElement
			const line = document.querySelector(".keywords-line") as HTMLElement
			
			if (!group || !line) return
			
			// Generate a random negative x position between 0 and 10
			function getRandomX(): number {
				return Math.floor(Math.random() * 11) * -1
			}

			// Store the x position of the last clone to avoid duplicates
			let storedX = 0

			for (let i = 0; i < config.KEYWORDS_LINE_COUNT; i++) {
				const clone = line.cloneNode(true) as HTMLElement
				let x = getRandomX()

				// If the generated x position is the same as the last one, generate a new one
				while (x === storedX) {
					x = getRandomX()
				}

				gsap.set(clone, { xPercent: x })
				group.appendChild(clone)
				storedX = x
			}

			for (let j = 0; j < config.KEYWORDS_GROUP_COUNT; j++) {
				const clone = group.cloneNode(true)
				keywords.appendChild(clone)
			}
		}

		// Create master timeline
		const master = gsap.timeline({ delay: 0.5 })

		function createMaskInAnimation() {
			master
				.to(mask, {
					clipPath: "polygon(40% 40%, 60% 40%, 60% 60%, 40% 60%)",
					duration: 1,
					ease: "power3.inOut",
				})
				.to(mask, {
					clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
					duration: 0.5,
					ease: "power1.inOut",
				}, "+=0.25")
				.addLabel("maskHalf")
				.set(root, {
					color: "var(--color-black)",
					backgroundColor: "var(--color-white)"
				}, "maskHalf")
		}

		function createImagesAnimation() {
			// Animate images with stagger
			master.to(images, {
				clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
				duration: 1,
				ease: "hop",
				stagger: 0.75,
			}, "maskHalf-=0.3")

			// Animate image scales with stagger
			master.to(imgs, {
				scale: 1,
				duration: 1.5,
				ease: "hop",
				stagger: 0.75,
			}, "maskHalf-=0.5")
			.addLabel("imagesEnd")
			.set(imageSplit, {
				display: "block",
			}, "imagesEnd")
			.set(imageWrapper, {
				display: "none"
			})
			.set(tag, {
				opacity: 1,
			})
		}

		function createSplitImageAnimation () {
			master.to(imageSplitLeft, {
				xPercent: -120,
				duration: 1,
				ease: "power3.inOut",
			}, "imagesEnd")
			.to(imageSplitRight, {
				xPercent: 120,
				duration: 1,
				ease: "power3.inOut",
			}, "imagesEnd").addLabel("splitImageEnd")
		}

		function createMaskOutAnimation() {
			master
				.to(mask, {
					clipPath: "polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%)",
					duration: 1.5,
					ease: "power3.inOut",
				}, "splitImageEnd-=1.5")
				.addLabel("maskOutEnd")
		}

		function createLogoAnimation() {
			// Animate paths to their original positions with random stagger
			master.to(logoPaths, {
				opacity: 1,
				duration: 0.5,
				ease: "power2.out",
				stagger: {
					amount: 0.75,
					from: "random"
				}
			}, "maskOutEnd-=0.25")
			.addLabel("logoEnd")
		}
	
		function createWordsAnimation() {
			const words = gsap.utils.toArray<HTMLElement>("#content .words h2, #content .words p")
			
			if (words.length === 0) return

			const { lines } = SplitText.create(words, {
				type: "lines",
				linesClass: "line++",
				mask: "lines",
			});

			gsap.set(wordsWrapper, { opacity: 1 })
			gsap.set(lines, { yPercent: 100 })

			master.to(lines, {
				yPercent: 0,
				duration: 0.5,
				ease: "power2.out",
				stagger: 0.25,
			}, "logoEnd-=0.25")
		}

		// Initialize and animate
		cloneKeywords()

		createMaskInAnimation()
		createImagesAnimation()
		createSplitImageAnimation()
		createMaskOutAnimation()
		createLogoAnimation()
		createWordsAnimation()
	})
</script>
