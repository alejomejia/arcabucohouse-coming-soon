---
import '@/styles/global.css'
import { SEO_DEFAULT } from '@/utils/const';
import { config } from '@/utils/const';

interface Props {
	title?: string;
	description?: string;
	imageUrl?: string;
}

const { title, description, imageUrl } = Astro.props;

const isDev = config.DEV
const umamiWebsiteId = config.UMAMI_WEBSITE_ID
const websiteDomain = config.WEBSITE_DOMAIN
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ?? SEO_DEFAULT.title}</title>

		<meta name="title" content={title ?? SEO_DEFAULT.title}>
		<meta name="description" content={description ?? SEO_DEFAULT.description}>
		<meta name="keywords" content="interiorism, high-end, colombian, artisans, lights, ceramics, rugs, art">
		<meta name="robots" content="index, follow">
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
		<meta name="language" content="English">
		<meta name="revisit-after" content="30 days">

		<meta property="og:title" content={title ?? SEO_DEFAULT.title}>
		<meta property="og:site_name" content={websiteDomain}>
		<meta property="og:url" content={websiteDomain}>
		<meta property="og:description" content={description ?? SEO_DEFAULT.description}>
		<meta property="og:type" content="website">
		<meta property="og:image" content={imageUrl ?? SEO_DEFAULT.imageUrl}>

		{!isDev && umamiWebsiteId && (
			<script src="https://cloud.umami.is/script.js" data-website-id={umamiWebsiteId} defer></script>
		)}
	</head>
	<body>
		<slot />
	</body>
</html>
