---
interface Count {
  blocks?: number;
  rows?: number;
}

interface Props {
  words: string[];
  decorator?: string;
  count?: Count;
  animationDuration?: number;
}

const DEFAULT_BLOCKS_COUNT = 5;
const DEFAULT_ROWS_COUNT = 100;
const DEFAULT_ANIMATION_DURATION = 120;

const { 
  words = [], 
  decorator = "~", 
  count,
  animationDuration = DEFAULT_ANIMATION_DURATION 
} = Astro.props;

const blocksCount = count?.blocks ?? DEFAULT_BLOCKS_COUNT;
const rowsCount = count?.rows ?? DEFAULT_ROWS_COUNT;

const wordsWithDecorator = words.join(` ${decorator} `);
const rowContent = Array.from({ length: blocksCount }, () => wordsWithDecorator)
  .join(` ${decorator} `);

const rows = Array.from({ length: rowsCount }, (_, index) => index);
---

<div 
  class="text-base opacity-30" 
  aria-hidden="true"
  style={`--animation-duration: ${animationDuration}s`}
>
  {rows.map(() => (
    <div class="keywords-group">
      <div class="keywords-row text-nowrap">
        <span class="inline-block will-change-transform">{rowContent}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .keywords-group:nth-child(even) .keywords-row span {
    animation: moveRight var(--animation-duration, 120s) ease-in-out infinite;
  }

  .keywords-group:nth-child(odd) .keywords-row span {
    margin-left: 50%;
    animation: moveLeft var(--animation-duration, 120s) ease-in-out infinite;
  }

  @keyframes moveRight {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes moveLeft {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .keywords-row span {
      animation: none !important;
    }
  }
</style>